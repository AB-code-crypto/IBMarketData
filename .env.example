TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_THREAD_ID_DEAL=7
TELEGRAM_THREAD_ID_CONNECT=1
TELEGRAM_THREAD_ID_MAIN=1
TELEGRAM_THREAD_ID_DEAL_STATUS=5723
TELEGRAM_THREAD_ID_ERROR=7042

# Fail-closed guard: exact account that must be exposed by the selected TWS session.
IB_ACCOUNT_ID=U1234567

# TWS / IB Gateway endpoint used by this robot instance.
# Typical local TWS ports: 7497 for paper, 7496 for live.
# Multiple local TWS instances must use different API socket ports.
IB_HOST=127.0.0.1
IB_PORT=7497

# Base API client id for this robot. Internal services add their own offsets,
# so use a separate base range for every robot connected to the same TWS.
IB_CLIENT_ID=200

# Daily take-profit for this robot instance.
# Trading-day boundary: 00:00 Moscow time.
DAILY_TAKE_PROFIT_ENABLED=true
DAILY_TAKE_PROFIT_USD=500.0

# Rolling signal settings for this robot instance.
ROLLING_SIGNAL_STEP_SECONDS=60
ROLLING_BACK_MINUTES=90
ROLLING_TRADE_MINUTES=30

# Candidate-potential settings for this robot instance.
CANDIDATE_POTENTIAL_MIN_COUNT=3
CANDIDATE_POTENTIAL_MAX_COUNT=9
CANDIDATE_POTENTIAL_MIN_ABS_END_DELTA_POINTS=10.0
